{
  "info": {
    "name": "EvidenceChain API",
    "description": "Chạy server: venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --reload-dir backend. Tài khoản: duongsu / 1234 (đương sự), thuky / 5678 (thư ký). Chạy 1a, 1c trước: token tự lưu vào biến của collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "partyToken",
      "value": ""
    },
    {
      "key": "clerkToken",
      "value": ""
    },
    {
      "key": "receiptCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Đăng nhập",
      "item": [
        {
          "name": "1a. Thư ký đăng nhập (thuky / 5678)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"thuky\",\n  \"password\": \"5678\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('clerkToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1b. Sai mật khẩu → 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"thuky\",\n  \"password\": \"sai\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1c. Đương sự đăng nhập (duongsu / 1234)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"duongsu\",\n  \"password\": \"1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('partyToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "1d. Tôi là ai (GET /me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{partyToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Lưu chứng (đương sự)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{partyToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "2a. Lưu chứng (nộp file)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/submissions",
            "description": "Body > form-data: key files, đổi kiểu Text -> File, chọn file. Chỉ nhận PDF, ảnh, video, âm thanh; file khác (.exe, .zip, .docx...) -> 400 FILE_TYPE_NOT_ALLOWED. Nhiều file thì thêm nhiều dòng cùng key files.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('202', () => pm.response.to.have.status(202));",
                  "const r = pm.response.json();",
                  "pm.test('chờ neo', () => pm.expect(r.status).to.eql('PENDING_ANCHOR'));",
                  "pm.collectionVariables.set('receiptCode', r.receiptCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "2b. Danh sách biên nhận của tôi",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/submissions?page=1&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2c. Xem biên nhận",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/receipts/{{receiptCode}}",
            "description": "status: PENDING_ANCHOR (chưa chạy worker) / ANCHORED (có anchor.txHash, explorerUrl) / ANCHOR_FAILED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('có chữ ký', () => pm.expect(pm.response.json().signature).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2d. Tra cứu bằng file",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/submissions/lookup",
            "description": "form-data: key 'file' (kiểu File) = một file đã lưu chứng (đổi tên không sao). File khác → 404 RECORD_NOT_FOUND.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2e. Không gửi file → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/submissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 FILE_REQUIRED', () => pm.expect(pm.response.json().error.code).to.eql('FILE_REQUIRED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Phân quyền",
      "item": [
        {
          "name": "3a. Thư ký lưu chứng → 403",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/submissions",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 FORBIDDEN', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "3b. Không có token → 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Khóa công khai kiểm chữ ký",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/signing-key"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
