# Sao chép thành .env ở thư mục gốc repo rồi điền giá trị. Không commit .env.
# Tài khoản ứng dụng (ít quyền: không UPDATE/DELETE bảng chỉ ghi thêm) và chủ sở hữu bảng (chạy migration).
# Mật khẩu khớp docker-compose.yml + backend/docker/postgres-init (chỉ dùng trên máy dev).
DATABASE_URL=postgresql+psycopg://evidence_app:app_dev_pw@localhost:5432/evidencechain
MIGRATION_DATABASE_URL=postgresql+psycopg://evidence_owner:owner_dev_pw@localhost:5432/evidencechain

# Ví TEST trên Sepolia, chỉ để worker gửi giao dịch neo. Bỏ trống thì biên nhận ở trạng thái "Chờ neo".
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PRIVATE_KEY=0x...khoa_vi_test
# Địa chỉ công khai của ví đó (worker in ra khi chạy), để POST /verify kiểm giao dịch gửi từ ví hệ thống
# ANCHOR_WALLET_ADDRESS=0x...

# Khóa ký biên nhận tạm (EIP-191, secp256k1), KHÁC khóa ví neo.
# Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
RECEIPT_SIGNING_KEY=...
# Số khóa ký đang dùng (mặc định 1)
# RECEIPT_KEY_NO=1
# Địa chỉ khóa ký đã công bố; trống thì lấy từ RECEIPT_SIGNING_KEY
# RECEIPT_SIGNER_ADDRESS=0x...
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=...

# per_submission: neo sau mỗi lần nộp (demo) | daily: mỗi ngày 1 đợt, chốt ở mốc ANCHOR_DAILY_CUTOFF (giờ VN)
ANCHOR_MODE=per_submission
ANCHOR_DAILY_CUTOFF=23:59
# Giao dịch kẹt gửi lại (phí x2 mỗi lần) quá số lần này thì dừng job neo
ANCHOR_MAX_REPLACEMENTS=5
# Thư ký chỉ đối chiếu biên nhận đã neo ("Đã khóa"). false: cho phép đối chiếu qua API khi chưa neo (chỉ để test)
REQUIRE_ANCHOR_BEFORE_VERIFY=true
